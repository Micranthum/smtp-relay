# SMTP Relay Configuration for Legacy Clients (SSL Mode)
# Use this configuration for old programs that only support implicit SSL/TLS

# Environment
ENVIRONMENT=production

# SMTP Relay Server - SSL Mode (port 465)
SMTP_RELAY_HOST=0.0.0.0
SMTP_RELAY_PORT=465

# SMTP Encryption Mode - SSL for legacy compatibility
# SSL: Connection is encrypted from the start (implicit TLS)
# This is required for old Contpaq versions and other legacy SMTP clients
SMTP_ENCRYPTION_MODE=SSL

# TLS Certificates (required for SSL mode)
TLS_CERT_FILE=/app/certs/cert.pem
TLS_KEY_FILE=/app/certs/key.pem

# Basic Auth Credentials (for Contpaq to authenticate against this relay)
SMTP_RELAY_USERNAME=contpaq.nominas
SMTP_RELAY_PASSWORD=nominas2025

# Microsoft 365 SMTP Configuration
MS365_SMTP_HOST=smtp-mail.outlook.com
MS365_SMTP_PORT=587

# Microsoft 365 OAuth2 Configuration
# Create an app registration in Azure AD: https://portal.azure.com
MS365_TENANT_ID=your-tenant-id-here
MS365_CLIENT_ID=your-client-id-here
MS365_CLIENT_SECRET=your-client-secret-here
MS365_EMAIL_ADDRESS=your-email@yourdomain.com

# Security
ALLOWED_IPS=*
# For production, restrict to specific IPs: 192.168.1.100,10.0.0.50

ALLOWED_SENDERS=*
# To restrict senders, use comma-separated list: user1@domain.com,user2@domain.com

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Rate Limiting (emails per minute)
RATE_LIMIT_PER_MINUTE=60
