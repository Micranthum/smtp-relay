# SMTP Relay Server Configuration
SMTP_RELAY_HOST=0.0.0.0
SMTP_RELAY_PORT=587
SMTP_RELAY_USE_TLS=true

# SMTP Encryption Mode
# Options: STARTTLS (default, port 587), SSL (implicit TLS, port 465), NONE (no encryption)
# STARTTLS: Modern clients, connection starts plain and upgrades to TLS
# SSL: Legacy clients (old Contpaq, etc.), connection is encrypted from start
# NONE: No encryption - only for development/testing
SMTP_ENCRYPTION_MODE=STARTTLS

# Basic Auth Credentials (for Contpaq to authenticate against this relay)
SMTP_RELAY_USERNAME=contpaq.nominas
SMTP_RELAY_PASSWORD=nominas2025

# Microsoft 365 SMTP Configuration
MS365_SMTP_HOST=smtp-mail.outlook.com
MS365_SMTP_PORT=587

# Microsoft 365 OAuth2 Configuration
# Create an app registration in Azure AD: https://portal.azure.com
MS365_TENANT_ID=b32d1b5f-e512-41fa-8d62-bd691fcbea2c
MS365_CLIENT_ID=0726a531-a5bd-4f5f-831e-ec7d2a10b9e7
MS365_CLIENT_SECRET=S6v8Q~HR2S9sWdu.v2IlQJhutQiChlH1e8-3Cc9i
MS365_EMAIL_ADDRESS=recibos.contpaqi@aguafria.mx

# Security
ALLOWED_IPS=*
# To restrict IPs, use comma-separated list: 192.168.1.100,10.0.0.50
# Note: '*' allows all IPs (use with caution in production)

ALLOWED_SENDERS=*
# To restrict senders, use comma-separated list: user1@domain.com,user2@domain.com

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Rate Limiting (emails per minute)
RATE_LIMIT_PER_MINUTE=60
