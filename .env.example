# =============================================================================
# SMTP Relay - Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
#
# =============================================================================

# =============================================================================
# SECRETS (Required - fill these in)
# =============================================================================
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
GRAPH_API_TENANT_ID=
GRAPH_API_CLIENT_ID=
GRAPH_API_CLIENT_SECRET=
MS365_EMAIL_ADDRESS=

# =============================================================================
# CONFIGURATION (Optional)
# =============================================================================
ENVIRONMENT=development
SMTP_RELAY_HOST=0.0.0.0
SMTP_STARTTLS_PORT=587
SMTP_SSL_PORT=465
SMTP_RELAY_USE_TLS=false
TLS_CERT_FILE=/app/certs/smtp_relay.crt
TLS_KEY_FILE=/app/certs/smtp_relay.key
GRAPH_API_AUTHORITY_BASE=https://login.microsoftonline.com
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
GRAPH_API_SCOPE=https://graph.microsoft.com/.default
ALLOWED_IPS=*
ALLOWED_SENDERS=*
LOG_LEVEL=INFO

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# REDIS / RQ JOB QUEUE
# =============================================================================
REDIS_URL=redis://redis:6379/0
RQ_MAX_RETRIES=3
RQ_RETRY_INTERVALS=60,300,900

# =============================================================================
# PROMETHEUS METRICS
# =============================================================================
METRICS_PORT=8000

# =============================================================================
# PROMETHEUS / ALERTMANAGER (monitoring stack)
# =============================================================================
# PROMETHEUS_RETENTION_TIME is read by docker-compose.yml for the prometheus
# service's --storage.tsdb.retention.time flag.
PROMETHEUS_RETENTION_TIME=90d

# Alertmanager renders its config from monitoring/render-alertmanager-config.sh
# at container startup, reading these directly via env_file — no separate
# secrets file to keep in sync. Get a bot token from @BotFather on Telegram;
# chat_id is the destination chat/group (negative number for groups).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
