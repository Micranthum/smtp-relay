# =============================================================================
# SMTP Relay - PRODUCTION Environment Configuration
# =============================================================================

# Environment: MUST be 'production'
ENVIRONMENT=development

# =============================================================================
# SMTP Relay Server Configuration
# =============================================================================
SMTP_RELAY_HOST=0.0.0.0
SMTP_STARTTLS_PORT=587  
SMTP_SSL_PORT=465       # Implicit SSL

# TLS/SSL Configuration
SMTP_RELAY_USE_TLS=true

# TLS Certificate Files
TLS_CERT_FILE=/app/certs/smtp_relay.crt
TLS_KEY_FILE=/app/certs/smtp_relay.key

# =============================================================================
# Authentication - Basic Auth Credentials
# =============================================================================
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=

# =============================================================================
# Microsoft Graph API OAuth2 Configuration
# =============================================================================
GRAPH_API_TENANT_ID=
GRAPH_API_CLIENT_ID=
GRAPH_API_CLIENT_SECRET=
MS365_EMAIL_ADDRESS=

# =============================================================================
# Security Configuration - CRÍTICO PARA PRODUCCIÓN
# =============================================================================

# IP Whitelist
ALLOWED_IPS=*
# To restrict IPs, use comma-separated list: 192.168.1.100,10.0.0.50
# Note: '*' allows all IPs (use with caution in production)

ALLOWED_SENDERS=*
# To restrict senders, use comma-separated list: user1@domain.com,user2@domain.com

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

