# =============================================================================
# SMTP Relay - PRODUCTION Environment Configuration
# =============================================================================
# 
# IMPORTANTE: Este es un archivo de ejemplo para configuración de producción
# 
# Pasos para usar en producción:
# 1. Copiar este archivo a .env
# 2. Actualizar todos los valores con configuración real
# 3. NUNCA commitear este archivo a git con valores reales
# 
# =============================================================================

# Environment: MUST be 'production'
ENVIRONMENT=production

# =============================================================================
# SMTP Relay Server Configuration
# =============================================================================
SMTP_RELAY_HOST=0.0.0.0
SMTP_RELAY_PORT=587

# TLS/SSL Configuration - RECOMENDADO para producción
# Habilitar TLS cuando tengas certificados
SMTP_RELAY_USE_TLS=true

# TLS Certificate Files
# Coloca tus certificados en el directorio ./certs/
# El volumen de Docker montará ./certs:/app/certs
TLS_CERT_FILE=/app/certs/smtp_relay.crt
TLS_KEY_FILE=/app/certs/smtp_relay.key

# =============================================================================
# Authentication - Basic Auth Credentials
# =============================================================================
# CAMBIAR estas credenciales por valores seguros en producción
SMTP_RELAY_USERNAME=contpaq.nominas
SMTP_RELAY_PASSWORD=CAMBIAR_ESTA_CONTRASEÑA_EN_PRODUCCION

# =============================================================================
# Microsoft 365 Configuration
# =============================================================================
MS365_SMTP_HOST=smtp-mail.outlook.com
MS365_SMTP_PORT=587

# =============================================================================
# Microsoft 365 OAuth2 Configuration
# =============================================================================
# Valores de tu App Registration en Azure AD
MS365_TENANT_ID=TU_TENANT_ID_AQUI
MS365_CLIENT_ID=TU_CLIENT_ID_AQUI
MS365_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI
MS365_EMAIL_ADDRESS=recibos.contpaqi@tudominio.com

# =============================================================================
# Security Configuration - CRÍTICO PARA PRODUCCIÓN
# =============================================================================

# IP Whitelist - OBLIGATORIO en producción
# Especificar SOLO las IPs del servidor de Contpaq
# Ejemplo: Si Contpaq está en 192.168.1.50
ALLOWED_IPS=192.168.1.50

# Email Whitelist - RECOMENDADO en producción
# Especificar SOLO los emails permitidos para enviar
# Ejemplo: Solo permitir el buzón compartido
ALLOWED_SENDERS=recibos.contpaqi@tudominio.com

# =============================================================================
# Logging Configuration
# =============================================================================
# Para producción usar INFO o WARNING
LOG_LEVEL=INFO

# =============================================================================
# Rate Limiting
# =============================================================================
# Ajustar según el volumen esperado de correos
# 60 = máximo 60 emails por minuto por remitente
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Notas de Seguridad para Producción
# =============================================================================
# 
# 1. NUNCA usar ALLOWED_IPS=* en producción
# 2. NUNCA usar ALLOWED_SENDERS=* en producción
# 3. Usar contraseñas fuertes (mínimo 16 caracteres, alfanuméricos + símbolos)
# 4. Habilitar TLS con certificados válidos
# 5. Mantener este archivo fuera de control de versiones (.gitignore)
# 6. Hacer backup seguro de las credenciales
# 7. Rotar passwords periódicamente
# 8. Monitorear logs regularmente
# 
# =============================================================================
